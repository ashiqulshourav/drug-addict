# Keep the real .env outside the web root and never commit it.
DB_HOST=localhost
DB_NAME=drug
DB_USER=replace_with_least_privilege_user
DB_PASS=replace_with_strong_password

# Optional reverse-proxy configuration. Do not trust forwarded headers by default.
# ENV_FILE=/absolute/path/to/.env

TURNSTILE_ENABLED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=example.com
TURNSTILE_LOCAL_ENABLED=
TURNSTILE_LOCAL_SITE_KEY=
TURNSTILE_LOCAL_SECRET_KEY=

REPORT_RATE_LIMIT_WINDOW=
REPORT_RATE_LIMIT_MAX_REQUESTS=
REPORT_BURST_WINDOW=
REPORT_BURST_MAX_REQUESTS=
REPORT_SAME_LOCATION_MAX_REQUESTS=
GLOBAL_REPORT_RATE_LIMIT_WINDOW=
GLOBAL_REPORT_RATE_LIMIT_MAX_REQUESTS=