# Keep the real .env outside the web root and never commit it.
DB_HOST=localhost
DB_NAME=drug
DB_USER=replace_with_least_privilege_user
DB_PASS=replace_with_strong_password

# Optional reverse-proxy configuration. Do not trust forwarded headers by default.
# ENV_FILE=/absolute/path/to/.env

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=example.com
TURNSTILE_LOCAL_ENABLED=true
TURNSTILE_LOCAL_SITE_KEY=1x00000000000000000000AA
TURNSTILE_LOCAL_SECRET_KEY=1x0000000000000000000000000000000AA

REPORT_RATE_LIMIT_WINDOW=3600
REPORT_RATE_LIMIT_MAX_REQUESTS=20
GLOBAL_REPORT_RATE_LIMIT_WINDOW=3600
GLOBAL_REPORT_RATE_LIMIT_MAX_REQUESTS=200