Options -Indexes
RewriteEngine On

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "^(\.env|\.gitignore|.\*\.(?:bak|config|ini|log|sql|sql~|swp))$">
Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
	RewriteRule ^(?:\.git|config|data|storage|tools)(?:/|$) - [F,L,NC]
</IfModule>
DirectoryIndex public/index.html

# Serve the public frontend while keeping the API at the project root.

RewriteRule ^$ public/index.html [L]
RewriteRule ^reports/(?:location=)?[0-9]+/?$ public/reports.html [L,QSA,NC]
RewriteRule ^reports/?$ public/reports.html [L]
RewriteRule ^(?:index\.html)?$ public/index.html [L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
