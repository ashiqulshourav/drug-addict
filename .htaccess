Options -Indexes
DirectoryIndex public/index.html

RewriteEngine On

# Serve the public frontend while keeping the API at the project root.
RewriteRule ^$ public/index.html [L]
RewriteRule ^reports/(?:location=)?[0-9]+/?$ public/reports.html [L,QSA,NC]
RewriteRule ^reports/?$ public/reports.html [L]
RewriteRule ^(?:index\.html)?$ public/index.html [L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]