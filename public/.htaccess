Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On

# Keep clean report URLs working when public/ is the document root.
RewriteRule ^reports/(?:location=)?[0-9]+/?$ reports.html [L,QSA,NC]
RewriteRule ^reports/?$ reports.html [L]
RewriteRule ^location\.html$ location.html [L,QSA,NC]

<FilesMatch "\.(php|phtml|phar|php[0-9]*)$">
  Require all denied
</FilesMatch>