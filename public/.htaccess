Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Keep clean report URLs working when public/ is the document root.
RewriteRule ^reports/(?:location=)?[0-9]+/?$ reports.html [L,QSA,NC]
RewriteRule ^reports/?$ reports.html [L]

<FilesMatch "\.(php|phtml|phar|php[0-9]*)$">
  Require all denied
</FilesMatch>